# Copy to .env and adjust as needed. All vars are prefixed ASSISTANT_.

# Which inference backend the LLMEngine factory builds. Currently: "ollama".
ASSISTANT_ENGINE=ollama

# Ollama REST endpoint (local only).
ASSISTANT_OLLAMA_HOST=http://localhost:11434

# Default model (must be pulled: `ollama pull <name>`).
# llama3.2:latest = Llama 3.2 3B (~2GB), the recommended default for 8GB RAM.
ASSISTANT_DEFAULT_MODEL=llama3.2:latest

# Safety-net model if the default is too heavy on this machine.
ASSISTANT_FALLBACK_MODEL=llama3.2:1b

# Sampling.
ASSISTANT_TEMPERATURE=0.7

# Seconds before an inference request is abandoned.
ASSISTANT_REQUEST_TIMEOUT_S=120
